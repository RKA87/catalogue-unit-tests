pipeline {
    agent {
        node {
            label 'roboshop'
        }
    }
    environment {
        awsAccId = "381491827632"
        awsRegion = "us-east-1"
        appName = ""
        appVersion = ""
    }
    options {
        // disableConcurrentBuilds()
        timeout(time:10, unit:"MINUTES")
    }
    stages {
        stage ('ReadApp Version') {
            steps {
                script {

                    def data = readJSON file: 'package.json'

                    appName = data.name
                    appVersion = data.version

                    echo "Application Name: ${appName} Version: ${appVersion}"

                    echo "Application hosting in AWS Account ${env.awsAccId} in ${env.awsRegion} region"
                }
            }
        }
        stage ('Install Depedencies') {
            steps {
                script {
                    sh """
                    echo "npm instllation follows"
                    npm install
                    """
                }
            }
        }
        stage ('Run Unit Tests Using Jest') {
            steps {
                script {
                    sh """
                        npm test

                    """
                }
            }
        }
        // stage ('sonarqube analaysis') {
        //     steps {
        //         withSonarQubeEnv('sonarqube-instance') {

        //             script {

        //                 def scannerHome = tool name:'sonar-8'
        //                 sh """
        //                     echo "performing sonarqube analysis"
        //                     ${scannerHome}/bin/sonar-scanner

        //                 """
        //             }
        //         }
        //     }
        // }
        // stage ('qualitygate analysis') {
        //     steps {
        //         script {
        //             timeout(time:5, unit:"MINUTES") {
        //                 waitForQualityGate abortPipeline: true

        //             }

        //         }

        //     }
        // }
        stage('Dependabot Security Check') {
            steps {
                withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
                    script {
                        echo "Querying Dependabot alerts for HIGH and CRITICAL severities..."
                        def GITHUB_OWNER = "RKA87"
                        def GITHUB_REPO = "catalogue-unit-tests"

                        def response = sh(
                            script: '''
                                curl -s -w "\n%{http_code}" \
                                -H "Authorization: Bearer $GITHUB_TOKEN" \
                                -H "Accept: application/vnd.github+json" \
                                -H "X-GitHub-Api-Version: 2022-11-28" \
                                "https://api.github.com/repos/RKA87/catalogue-unit-tests/dependabot/alerts?state=open&per_page=100"
                            ''',
                            returnStdout: true
                        ).trim()

                        def lines    = response.split('\n')
                        def httpCode = lines[-1].trim()
                        def jsonBody = lines[0..-2].join('\n')

                        if (httpCode != '200') {
                            error("GitHub API returned HTTP ${httpCode}. Check token and repo permissions.\nBody: ${jsonBody}")
                        }

                        def alerts   = readJSON text: jsonBody
                        def critical = alerts.findAll { alert ->
                            def sev = alert?.security_advisory?.severity?.toUpperCase()
                            sev in ['HIGH', 'CRITICAL']
                        }

                        if (critical.size() > 0) {
                            echo "\n===== DEPENDABOT SECURITY ALERTS DETECTED ====="
                            echo "Found ${critical.size()} HIGH/CRITICAL alert(s):\n"

                            critical.each { alert ->
                                def pkg = alert?.dependency?.package?.name ?: 'unknown'
                                def eco = alert?.dependency?.package?.ecosystem ?: ''
                                def sev = alert?.security_advisory?.severity?.toUpperCase()
                                def cve = alert?.security_advisory?.cve_id ?: alert?.security_advisory?.ghsa_id ?: 'N/A'
                                def sum = alert?.security_advisory?.summary ?: 'No summary'
                                def url = alert?.html_url ?: ''

                                echo "----------------------------------------------"
                                echo "  Package  : ${pkg} (${eco})"
                                echo "  Severity : ${sev}"
                                echo "  CVE/GHSA : ${cve}"
                                echo "  Summary  : ${sum}"
                                echo "  Details  : ${url}"
                            }

                            echo "----------------------------------------------"
                            error("Pipeline failed: ${critical.size()} HIGH/CRITICAL Dependabot alert(s) found.")
                        } else {
                            echo "No HIGH or CRITICAL Dependabot alerts found. Proceeding..."
                        }
                    }
                }
            }
        }
        stage ('build artifact/image') {
            steps {
                script {
                    withAWS(credentials: 'aws-creds', region: "${env.awsRegion}"){
                    sh """
                        aws ecr get-login-password --region ${env.awsRegion} | docker login --username AWS --password-stdin ${env.awsAccId}.dkr.ecr.${env.awsRegion}.amazonaws.com

                        docker build -t ${env.awsAccId}.dkr.ecr.${env.awsRegion}.amazonaws.com/roboshop/${appName}:${appVersion} .

                        docker push ${env.awsAccId}.dkr.ecr.${env.awsRegion}.amazonaws.com/roboshop/${appName}:${appVersion} 

                    """
                    }
                }
            }

        }
    }
    post {
        always {
            echo "post final checks"
        }
        success {
            echo "pipeline success"
        }
        failure {
            echo "pipeline failure"
        }
    }
}